{
  "name": "guia-medica-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --platform android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Format apk",
    "android:aab": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Format aab",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/contracts.test.ts",
    "format": "npx -y prettier@3.9.9 --write ."
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
